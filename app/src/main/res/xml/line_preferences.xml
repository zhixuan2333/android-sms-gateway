<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory app:title="@string/line_messaging_api">
        <SwitchPreference
            android:defaultValue="false"
            android:key="line.enabled"
            app:summary="@string/line_enabled_summary"
            app:title="@string/enabled" />
        <EditTextPreference
            android:key="line.channel_access_token"
            app:summary="@string/line_channel_access_token_summary"
            app:title="@string/line_channel_access_token" />
        <EditTextPreference
            android:key="line.recipient_user_id"
            app:summary="@string/line_recipient_user_id_summary"
            app:title="@string/line_recipient_user_id"
            app:useSimpleSummaryProvider="true" />
        <Preference
            android:key="line.send_test_message"
            app:summary="@string/line_send_test_summary"
            app:title="@string/line_send_test" />
    </PreferenceCategory>
</androidx.preference.PreferenceScreen>
